TRAEFIK_NETWORK=traefik
ROUTER_NAME=dealradar
ROUTER_RULE=Host(`dealradar.home.websters.at`)
DB_PATH=/data/dealradar.db
CACHE_TTL_S=120
EBAY_OAUTH_TOKEN=
# AI backends: local-first (Ollama on laptop, private, free), then OpenRouter free failover.
# Everything works with all of these empty (deterministic heuristics), just less smart.
LOCAL_API_URL=http://192.168.1.172:11434/v1
LOCAL_MODEL=qwen2.5:3b
LOCAL_VISION_API_URL=http://192.168.1.172:11434/v1
LOCAL_MODEL_VISION=qwen2.5vl:3b
# OpenRouter (https://openrouter.ai) — key NEVER goes in git
CLOUD_API_URL=https://openrouter.ai/api/v1
CLOUD_API_KEY=
CLOUD_MODELS=nvidia/nemotron-3.5-lightning:free,thinkingmachines/inkling-small:free,qwen/qwen3.8-27b:free
CLOUD_MODEL_VISION=qwen/qwen3.8-27b:free
# Jev hosted ($5 free credit, console.typesafe.ai) or self-hosted Kev (this laptop: KEV_URL=http://<laptop-ip>:8001/...)
JEV_API_KEY=
KEV_URL=
# Signal via homeserver signal-api (same host network path)
SIGNAL_API_URL=http://127.0.0.1:8082
SIGNAL_NUMBER=
NTFY_TOPIC_URL=
WEBHOOK_URL=
TRANSPORTS_JSON={}
