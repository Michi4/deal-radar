TRAEFIK_NETWORK=proxy
ROUTER_NAME=dealradar
ROUTER_RULE=Host(`dealradar.websters.at`)
# basic-auth in front (format user:apr1-hash). Generate: openssl passwd -apr1 <pw>
# IMPORTANT: double every $ in the hash ($ -> $$), compose interpolates .env values.
ADMIN_BASIC_AUTH=admin:$apr1$REPLACE$with-real-hash-from-openssl-passwd-apr1
DB_PATH=/data/dealradar.db
CACHE_TTL_S=120
# optional: official APIs / AI / decision models
# Jev hosted key: free $5 credit at console.typesafe.ai (no waitlist since Sep 20)
# Kev: free self-hosted (Apache-2.0, jaredpalmer/kev) — point KEV_URL at your server
EBAY_OAUTH_TOKEN=
JEV_API_KEY=
KEV_URL=
# push alerts: simplest is Signal via local signal-cli-rest-api, or fan-out JSON:
# NOTIFIERS_JSON=[{"type":"signal"},{"type":"ntfy","topic_url":"https://ntfy.sh/topic"},{"type":"telegram","bot_token":"...","chat_id":"..."}]
SIGNAL_API_URL=http://10.8.1.2:8082
# ^ homeserver signal-api over WireGuard (frankfurt=10.8.1.1). Same-host fallback: http://signal-api:8080.
SIGNAL_NUMBER=
NTFY_TOPIC_URL=
WEBHOOK_URL=
# cloud model (OpenAI-compatible) for NL search + Stage-B verification. Optional: everything works without it.
CLOUD_API_URL=https://openrouter.ai/api/v1
CLOUD_API_KEY=
CLOUD_MODEL=liquid/lfm-2.5-2.6b:free
# decision models: Jev hosted key (free $5 credit at console.typesafe.ai, no waitlist) or self-hosted Kev (free, Apache-2.0)
# (JEV_API_KEY / KEV_URL are set above)
# optional: per-driver transports, e.g.
# TRANSPORTS_JSON={"willhaben":{"type":"rotating","urls":["http://user:pass@host:port"]},"kleinanzeigen":{"type":"proxy","url":"http://user:pass@host:port"}}
TRANSPORTS_JSON={}
