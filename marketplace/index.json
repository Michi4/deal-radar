{
 "registry": "deal-radar marketplace",
 "version": 1,
 "contribute": "PR to marketplace/index.json in Michi4/deal-radar (see docs/DRIVER_AUTHORING.md)",
 "drivers": [
  {
   "id": "willhaben",
   "version": "0.3.0",
   "display_name": "Willhaben",
   "source": "builtin",
   "capabilities": [
    "search",
    "fetch_detail",
    "images",
    "location",
    "seller"
   ],
   "author": "deal-radar core",
   "license": "MIT"
  },
  {
   "id": "kleinanzeigen",
   "version": "0.4.0",
   "display_name": "Kleinanzeigen",
   "source": "builtin",
   "capabilities": [
    "search",
    "fetch_detail",
    "images",
    "location",
    "paged"
   ],
   "author": "deal-radar core",
   "license": "MIT"
  },
  {
   "id": "vinted",
   "version": "0.1.0",
   "display_name": "Vinted",
   "source": "builtin",
   "capabilities": [
    "search",
    "images",
    "paged"
   ],
   "author": "deal-radar core",
   "license": "MIT"
  },
  {
   "id": "shpock",
   "version": "0.1.0",
   "display_name": "Shpock",
   "source": "builtin",
   "capabilities": [
    "search",
    "images",
    "shipping"
   ],
   "author": "deal-radar core",
   "license": "MIT",
   "status": "limited",
   "status_reason": "First results page only (~60 items). Deep pages need the itemSearch persisted-query hash (see BLOCKERS.md) — help capture it from browser devtools."
  },
  {
   "id": "ricardo",
   "version": "0.1.0",
   "display_name": "Ricardo (CH)",
   "source": "builtin",
   "capabilities": [
    "search",
    "images",
    "location"
   ],
   "author": "deal-radar core",
   "license": "MIT",
   "status": "blocked",
   "status_reason": "Site bot-wall (HTTP 403) blocks server fetches. Legitimate options: official API access, user-supplied proxy in Secrets, or retry later — the driver reports this cleanly per search, never fakes results."
  },
  {
   "id": "ebay",
   "version": "0.1.0",
   "display_name": "eBay (official API)",
   "source": "builtin",
   "requires": [
    "EBAY_OAUTH_TOKEN"
   ],
   "capabilities": [
    "search",
    "fetch_detail",
    "images"
   ],
   "author": "deal-radar core",
   "license": "MIT",
   "status": "needs-credentials",
   "status_reason": "Paste EBAY_APP_ID + EBAY_CERT_ID (or EBAY_OAUTH_TOKEN) in Admin -> Secrets; the app mints its own token. No keyless path exists (public pages serve decoy cards)."
  },
  {
   "id": "_template",
   "version": "0.1.0",
   "display_name": "Template (copy me)",
   "source": "github:Michi4/deal-radar@main:drivers/_template",
   "capabilities": [
    "search"
   ],
   "author": "deal-radar core",
   "license": "MIT"
  }
 ],
