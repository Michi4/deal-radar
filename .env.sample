# deal-radar env template — copy to .env and fill in. Secrets NEVER go in git.

# eBay Browse API token (explicit override)
EBAY_OAUTH_TOKEN=

# eBay App ID / client ID (auto token mint)
EBAY_APP_ID=

# eBay Cert ID / client secret (auto token mint)
EBAY_CERT_ID=

# eBay marketplace (default EBAY_AT)
EBAY_MARKETPLACE=

# OpenAI-compatible base URL
CLOUD_API_URL=

# cloud model API key
CLOUD_API_KEY=

# cloud models, comma separated
CLOUD_MODELS=

# cloud vision model (e.g. mimo-v2.5:free)
CLOUD_MODEL_VISION=

# Kev SystemOne endpoint
KEV_URL=

# Jev API key
JEV_API_KEY=

# local Ollama OpenAI endpoint
LOCAL_API_URL=

# local vision model name (Ollama)
LOCAL_MODEL_VISION=

# Signal sender number
SIGNAL_NUMBER=

# ntfy topic URL
NTFY_TOPIC_URL=

# generic webhook URL
WEBHOOK_URL=

# notifier specs JSON (may embed creds)
NOTIFIERS_JSON=

# proxy transports JSON (may embed creds)
TRANSPORTS_JSON=

# GitHub token (Lab PR publishing)
GH_TOKEN=

# AI Lab on/off (1/0)
LAB_ENABLED=

# Lab PR publishing on/off (1/0)
LAB_PUBLISH=

# app login password (empty = off)
LOGIN_PASSWORD=

# API key for x-api-key header
API_KEY=

# rate limit per IP per minute
RATE_PER_MIN=
